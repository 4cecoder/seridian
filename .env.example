# Seridian contact form -> GitHub Projects
# Copy to .env.local and fill in. GET endpoint: /api/contact

# GitHub Personal Access Token (fine-grained recommended).
# See README "Contact form (GitHub Projects)" for setup steps.
GITHUB_TOKEN=ghp_your_token_here

# Repository where contact issues are created (owner/repo).
GITHUB_REPO=therodfather/seridian

# GitHub Projects v2 board — use project number (from URL) or GraphQL node ID.
# URL https://github.com/users/therodfather/projects/1 → number is 1
GITHUB_PROJECT_NUMBER=1
# GITHUB_PROJECT_ID=PVT_kwDO...  # optional alternative to GITHUB_PROJECT_NUMBER

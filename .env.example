# Seridian contact form -> Linear
# Copy to .env.local and fill in. GET endpoint: /api/contact

# Linear Personal API key. Create one at https://linear.app/settings/api
LINEAR_API_KEY=your_linear_api_key_here

# Linear team UUID for created issues (required).
# Fetch via GraphQL: { teams { nodes { id key name } } }
# Or find in the workspace URL: https://linear.app/<workspace>/team/<TEAM_KEY>
LINEAR_TEAM_ID=your_team_id_here

# Convex — https://convex.dev
# Run `bun x convex dev` to auto-generate .env.local with these values.
# For production, set via: `bun x convex deploy --configure seridian`
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url
CONVEX_DEPLOYMENT=your_convex_deployment_name
